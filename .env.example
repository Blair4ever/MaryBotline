# Application Configuration
APP_NAME=MARY
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
TIMEZONE=Asia/Bangkok

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# LINE Messaging API Configuration
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Database Configuration (PostgreSQL / SQLite fallback)
# For local development with SQLite fallback: sqlite+aiosqlite:///./mary.db
# For production PostgreSQL: postgresql+asyncpg://postgres:password@localhost:5432/mary_db
DATABASE_URL=sqlite+aiosqlite:///./mary.db

# LLM Configuration (Configurable Providers: gemini, openai, anthropic)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# GitHub Integration (Phase 6)
GITHUB_TOKEN=your_github_personal_access_token

